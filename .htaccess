# Apache 安全配置文件
# 禁止直接访问敏感目录和文件

DirectoryIndex index.php

# 禁止访问 data 和 includes 目录；其余路径交给 index.php（/health）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.ht|config\.local\.json$|resources\.json$|.*\.log$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.ht|config\.local\.json$|resources\.json$|.*\.log$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 禁止访问所有点开头的隐藏文件
# Apache 2.4 使用 Require；2.2 才使用 Order/Deny。
# 裸写 Order/Deny 会在未加载 mod_access_compat 的 2.4 主机上报
# "Invalid command 'Order'" 并直接返回 500，因此必须做模块判断。
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 禁止访问 .git 目录
<IfModule mod_rewrite.c>
    RewriteRule ^\.git/ - [F,L]
</IfModule>

# 禁止访问日志和本地配置文件
<IfModule mod_authz_core.c>
    <FilesMatch "\.(log|json\.local)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(log|json\.local)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# PHP 设置 (如果允许)。PHP 8+ 使用 mod_php.c，保留 php7 分支兼容旧主机。
<IfModule mod_php.c>
    php_flag display_errors off
    php_value error_log data/error.log
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors off
    php_value error_log data/error.log
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_value error_log data/error.log
</IfModule>

# 默认字符集
AddDefaultCharset UTF-8

# 安全响应头兜底
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
